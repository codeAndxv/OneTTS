# ==========================================
# OneTTS CPU 极速轻量镜像 (基于 uv + Python 3.12-slim)
# ==========================================
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 从官方镜像引入 uv 高性能包管理器
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# 安装基础系统库与音频处理依赖 (ffmpeg, libsndfile1)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 使用 uv 进行极速依赖安装
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# 复制服务端源码与 CLI
COPY server/ ./server/
COPY cli/ ./cli/
COPY config.yaml ./config.yaml
RUN uv sync --frozen --no-dev

# 创建数据与持久化目录
RUN mkdir -p /app/data/database /app/data/models /app/data/voices /app/data/outputs/cache

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8030

# 默认启动命令
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8030"]
